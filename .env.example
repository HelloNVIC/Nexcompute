# Nexcompute 管理端根环境配置模板（入库）
# 复制为 .env 并填入真实值；.env 被 gitignore 不入库。
# Spring Boot 经 spring.config.import=optional:file:.env[.properties] 读取；
# docker-compose backend 经 env_file: [.env] 注入同一份，本地与容器同源。
# 注意：值不要加引号——Spring properties 解析器不剥离引号（= 与 @ 在值中亦非特殊字符，无需引号）。

# ============ TrueNAS REST API（NAS 分配模块）============
# API key 须属 ACCOUNT_WRITE 角色，否则 user.create 在批准时被拒（启动 ping 不预检权限）
TRUENAS_BASE_URL=http://10.13.66.23
TRUENAS_API_KEY=1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TrueNAS 自签证书，关闭 TLS 校验（http:// 无影响，https:// 必关）
TRUENAS_VERIFY_TLS=false
# 单请求超时（秒）与连接错误重试次数
TRUENAS_TIMEOUT_SECONDS=30
TRUENAS_RETRIES=2
# 新用户 home 父目录（须在 TrueNAS /mnt 下，如 /mnt/tank/home）；设置后新用户开启 SSH/Shell，否则仅 SMB
# TRUENAS_USER_HOME_PARENT=/mnt/tank/home

# ============ AES-GCM 密码加密密钥（pending 注册密码暂存）============
# 16/24/32 字节，base64-urlsafe 编码。生成 32 字节：
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 含尾部 = ，不要加引号（= 在值中为字面字符）
PASSWORD_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ============ NAS 分配模块行为参数 ============
# 公开注册页基址（回退用：注册链接优先取当前请求 Origin/Referer，仅无请求上下文时用此）
NAS_PORTAL_BASE_URL=http://localhost:5173
# PENDING 注册超期天数（超过后扫描擦密码并置 REJECTED）
NAS_PENDING_EXPIRE_DAYS=7
# PENDING 超期扫描间隔（小时）
NAS_EXPIRY_SCAN_INTERVAL_HOURS=6

# ============ 数据库（PostgreSQL）============
DB_URL=jdbc:postgresql://localhost:5432/nexcompute
DB_USERNAME=nexcompute
# 密码含 @ 亦不要加引号（@ 在值中非特殊字符）
DB_PASSWORD=nexcompute

# ============ JWT ============
JWT_SECRET=dGhpcy1pcy1hLXZlcnktbG9uZy1zZWNyZXQta2V5LWZvci1qd3QtdG9rZW4tc2lnbmluZy1wbGVhc2UtY2hhbmdlLWl0

# ============ SMTP / 邮件（email-notification；空则回退 application.yml 默认）============
EMAIL_FROM=cufel@cufe.edu.cn
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_PROTOCOL=smtps
EMAIL_USER=cufel@cufe.edu.cn
EMAIL_PASSWD=
EMAIL_BRAND_NAME=合算 Nexcompute

# ============ 其他（可选，空则回退默认）============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
STORAGE_ROOT=./data/storage
